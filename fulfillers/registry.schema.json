{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["account_id", "name", "kinds", "operator", "description", "official", "proof"],
    "properties": {
      "account_id": { "type": "string", "minLength": 2 },
      "name": { "type": "string", "minLength": 1 },
      "kinds": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["bank_transfer", "cryptorefills_topup", "cryptorefills_code"] } },
      "operator": { "type": "string", "minLength": 1 },
      "repo_url": { "type": "string", "pattern": "^https://" },
      "description": { "type": "string", "minLength": 1 },
      "official": { "type": "boolean" },
      "proof": {
        "type": "object",
        "additionalProperties": false,
        "required": ["public_key", "signature", "message", "nonce"],
        "properties": {
          "public_key": { "type": "string", "minLength": 1 },
          "signature": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "nonce": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
