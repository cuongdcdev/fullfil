{
  "name": "fulfil",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:tunnel": "bash scripts/ops/dev-tunnel.sh",
    "prod:tunnel": "MODE=prod bash scripts/ops/dev-tunnel.sh",
    "test": "NEAR_AI_API_KEY= SAGE_API_KEY= vitest run && pnpm smoke && pnpm verify:qr",
    "smoke": "NEAR_AI_API_KEY= SAGE_API_KEY= DATABASE_URL=file:./data/smoke.db tsx scripts/reset.ts && NEAR_AI_API_KEY= SAGE_API_KEY= DATABASE_URL=file:./data/smoke.db tsx scripts/smoke.ts",
    "reset": "tsx scripts/reset.ts",
    "verify:qr": "tsx scripts/verify-qr-fixtures.ts",
    "verify:bundle": "tsx packages/attest/src/cli.ts",
    "coin-icons": "tsx scripts/fetch-coin-icons.ts",
    "telegram-bot": "tsx scripts/telegram-bot.ts"
  },
  "devDependencies": {
    "bs58": "^6.0.0",
    "viem": "^2.57.16",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "@napi-rs/canvas": "^0.1.80",
    "@types/qrcode": "^1.5.6",
    "@types/node": "^24",
    "concurrently": "^9.2.1",
    "jsqr": "^1.4.0",
    "next": "^15.5.28",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
